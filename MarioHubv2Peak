}, main)

local layout = create("UIListLayout", {
    Padding = UDim.new(0, 8),
    SortOrder = Enum.SortOrder.LayoutOrder
}, features)

local featureNames = {
    "God Mode",
    "Fly",
    "Speed Boost",
    "Infinite Jump",
    "Teleport",
    "Player HUD",
    "Anti Ragdoll"
}

for index, featureName in ipairs(featureNames) do
    local row = create("Frame", {
        Size = UDim2.new(1, -8, 0, 40),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
        LayoutOrder = index
    }, features)

    decorate(row, PURPLE, 10)

    create("TextLabel", {
        Position = UDim2.fromOffset(10, 0),
        Size = UDim2.new(1, -90, 1, 0),
        BackgroundTransparency = 1,
        Text = featureName,
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 14,
        Font = Enum.Font.GothamSemibold,
        TextXAlignment = Enum.TextXAlignment.Left
    }, row)

    local enabled = false

    local button = create("TextButton", {
        Size = UDim2.fromOffset(62, 28),
        Position = UDim2.new(1, -72, 0.5, -14),
        BackgroundColor3 = Color3.fromRGB(45, 48, 65),
        Text = "OFF",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 12,
        Font = Enum.Font.GothamBold
    }, row)

    decorate(button, CYAN, 8)

    button.Activated:Connect(function()
        enabled = not enabled
        button.Text = enabled and "ON" or "OFF"
        button.BackgroundColor3 = enabled
            and Color3.fromRGB(0, 110, 125)
            or Color3.fromRGB(45, 48, 65)
    end)
end

local function updateCanvas()
    features.CanvasSize = UDim2.new(
        0, 0, 0, layout.AbsoluteContentSize.Y + 8
    )
end

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
updateCanvas()

