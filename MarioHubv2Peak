local CYAN = Color3.fromRGB(0, 225, 255)
local PURPLE = Color3.fromRGB(150, 80, 255)
local DARK = Color3.fromRGB(14, 17, 32)
local PANEL = Color3.fromRGB(27, 32, 52)

local function create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function decorate(obj, color, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 12)
    }, obj)

    create("UIStroke", {
        Color = color or CYAN,
        Thickness = 1.5,
        Transparency = 0.1
    }, obj)
end

-- Drag support: mouse + touch
local function draggable(obj, handle)
    handle = handle or obj

    local dragging = false
    local startPosition
    local originalPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startPosition = input.Position
            originalPosition = obj.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - startPosition

            obj.Position = UDim2.new(
                originalPosition.X.Scale,
                originalPosition.X.Offset + delta.X,
                originalPosition.Y.Scale,
                originalPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

