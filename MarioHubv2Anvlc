local function setMenu(enabled)
    main.Visible = enabled
    toggle.Text = enabled and "⚡ MENU: ON" or "⚡ MENU: OFF"
    toggle.TextColor3 = enabled and cyan
        or Color3.fromRGB(180, 180, 195)
    toggle.BackgroundColor3 = enabled
        and Color3.fromRGB(18, 35, 55)
        or Color3.fromRGB(35, 35, 48)
end

toggle.Activated:Connect(function()
    setMenu(not main.Visible)
end)

hide.Activated:Connect(function()
    setMenu(false)
end)

close.Activated:Connect(function()
    setMenu(false)
end)

